{
  "name": "venue-rental-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace packages/backend",
    "dev:frontend": "npm run dev --workspace packages/frontend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:backend": "npm run build --workspace packages/backend",
    "build:frontend": "npm run build --workspace packages/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start --workspace packages/backend",
    "start:frontend": "npm run start --workspace packages/frontend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "lint": "npm run lint --workspace packages/backend && npm run lint --workspace packages/frontend",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
